{
  "name": "krusch-frontend-mcp",
  "version": "1.1.0",
  "description": "AI-powered frontend design & styling MCP server — deterministic HSL/WCAG color math, AST CSS-to-Tailwind compiler, Figma token parser, canonical HTML/SVG component templates, and sqlite-vec RAG design rule retrieval.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "krusch-frontend-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "seed": "node scripts/seed-design-rules.js && node scripts/ingest-refactoring-ui.js && node scripts/ingest-universal-a11y.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "frontend",
    "css",
    "tailwind",
    "design-system",
    "design-tokens",
    "wcag",
    "accessibility",
    "rag",
    "sqlite-vec",
    "ollama",
    "figma"
  ],
  "author": "kruschdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kruschdev/krusch-frontend-mcp.git"
  },
  "homepage": "https://github.com/kruschdev/krusch-frontend-mcp#readme",
  "bugs": {
    "url": "https://github.com/kruschdev/krusch-frontend-mcp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "css": "^3.0.0",
    "sqlite-vec": "^0.1.9"
  }
}
